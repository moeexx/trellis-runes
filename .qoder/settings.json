{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .qoder/hooks/inject-shell-session-context.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .qoder/hooks/inject-workflow-state.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
